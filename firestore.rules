rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin audit logs — only writable via server API (no client reads/writes)
    match /adminAuditLogs/{docId} {
      allow read, write: if false;
    }

    // Admin sessions — only writable via server API
    match /adminSessions/{docId} {
      allow read, write: if false;
    }

    // Access logs — only writable via server API, no client access
    match /accessLogs/{docId} {
      allow read, write: if false;
    }

    // Pad versions — readable/writable by anyone with the slug (security by obscurity;
    // no Firebase Auth available for ordinary users)
    match /padVersions/{slug}/snapshots/{snapshotId} {
      allow read, write: if true;
    }

    // Notes — readable/writable (no Firebase Auth for ordinary users)
    match /notes/{slug} {
      allow read, write: if true;
    }

    // Pad settings — readable/writable (password field is removed server-side)
    match /padSettings/{slug} {
      allow read, write: if true;
    }

    // Files and their chunk subcollections — readable/writable
    match /files/{document=**} {
      allow read, write: if true;
    }

    // One-time links
    match /oneTimeLinks/{linkId} {
      allow read, write: if true;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
